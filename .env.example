# === PostgreSQL ===
# Para rodar no mesmo banco do Projeto_ETA na VPS, use:
# DATABASE_URL=postgresql+psycopg://eta_user:eta_password_secure@eta_postgres_db:5432/eta_db
# (todas as tabelas do Jar Test usam prefixo jt_ e não conflitam com Projeto_ETA)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5433

POSTGRES_HOST=db

# === Backend ===
SECRET_KEY=
# Opcional: chave Fernet para CPF. Se vazia, derivada de SECRET_KEY.
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CPF_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_PORT=8001

# === Frontend ===
FRONTEND_URL=http://localhost:8002
FRONTEND_PORT=8002

# === SMTP (Verificação de e-mail e recuperação de senha) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=
SMTP_FROM=seu_email@gmail.com
SMTP_TLS=true

# === Administrador Inicial ===
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador Jar Test

# === Planos Pagos / Mercado Pago ===
# Preencher MERCADOPAGO_ACCESS_TOKEN após criar conta (Painel → Credenciais de produção).
# Com token vazio o sistema exibe "Pagamentos em breve" sem quebrar nada.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_BASE=https://api.mercadopago.com

PLANO_MENSAL_PRECO=4.99
PLANO_TRIMESTRAL_PRECO=14.99
PLANO_ANUAL_PRECO=49.99
